{
  "expo": {
    "name": "Connect",
    "slug": "Connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "connect",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jagatjeeban.connect",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.jagatjeeban.connect"
    },
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Connect to access your contacts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E1E",
          "image": "./assets/images/splash.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Outfit-Bold.ttf",
            "./assets/fonts/Outfit-Light.ttf",
            "./assets/fonts/Outfit-Regular.ttf",
            "./assets/fonts/Outfit-SemiBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe48e083-ffd5-4b00-a242-c9599dcf4871"
      }
    }
  }
}
